# POLYBOT local runtime template
# .env.example is a safe template only. Put real local secrets in .env.

# Core runtime
POLYBOT_DATABASE_URL=postgresql://polybot:polybot@127.0.0.1:55432/polybot
PHASE1_PERSISTENCE_ENABLED=true
PHASE1_AUTO_MIGRATE=false
POLYBOT_RUNTIME_MODE=paper_safe
POLYBOT_EXECUTION_BACKEND=paper
POLYBOT_REFRESH_INTERVAL_SECONDS=60
POLYBOT_TOP_N=10
POLYBOT_API_HOST=127.0.0.1
POLYBOT_API_PORT=8000
POLYBOT_LOG_LEVEL=INFO

# Intelligence
POLYBOT_INTELLIGENCE_NEWS_ENABLED=true
POLYBOT_INTELLIGENCE_REFRESH_INTERVAL_SECONDS=900
POLYBOT_INTELLIGENCE_WHALE_REFRESH_INTERVAL_SECONDS=900
POLYBOT_INTELLIGENCE_AI_ENABLED=true
NEWS_RSS_FEEDS=
NEWS_API_KEY=
CRYPTOPANIC_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=
DISCORD_BOT_TOKEN=
DISCORD_CHANNELS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=
OLLAMA_MODEL_PRIMARY=
OLLAMA_MODEL_REASONING=
AI_CONTEXT_OLLAMA_KEEP_ALIVE=5m
OPENAI_MODEL=
AI_CONTEXT_OPENAI_MODEL=
AI_CONTEXT_OPENAI_ENDPOINT=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CONTEXT_ANTHROPIC_MODEL=
AI_CONTEXT_ANTHROPIC_ENDPOINT=
ANTHROPIC_VERSION=2023-06-01
AI_CONTEXT_PROVIDER_ORDER=ollama,openai,anthropic
AI_CONTEXT_PROVIDER_TIMEOUT_SECONDS=90
AI_CONTEXT_TOTAL_TIMEOUT_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_TIMEOUT_FAST_SECONDS=60
OLLAMA_TIMEOUT_PRIMARY_SECONDS=90
OLLAMA_TIMEOUT_REASONING_SECONDS=120
AI_CONTEXT_MAX_PROMPT_CHARS=2000
AI_CONTEXT_MAX_RESPONSE_TOKENS=300
AI_CONTEXT_ENABLE_CLOUD_FALLBACK=true
AI_REQUIRED=false

# Paper capital
PAPER_STARTING_CAPITAL_USD=100
PAPER_MIN_CASH_RESERVE_PCT=0.20
PAPER_MAX_ALLOC_PER_TRADE_PCT=0.25
PAPER_MAX_TOTAL_DEPLOYMENT_PCT=0.75
PAPER_SAFE_MAX_CONCURRENT_POSITIONS=3

# Live safety defaults
LIVE_TRADING_ENABLED=false
LIVE_KILL_SWITCH=true
LIVE_MAX_ORDER_USD=2
LIVE_MAX_DAILY_LOSS=2
LIVE_MARKET_WHITELIST=
LIVE_MAX_CONCURRENT_POSITIONS=1
LIVE_MAX_SAME_MARKET_EXPOSURE=1
ALLOW_SCALING=false

# Venue credentials: keep blank in the template
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_SECRET=
POLYMARKET_CLOB_PASSPHRASE=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
